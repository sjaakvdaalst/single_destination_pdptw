@article{cordeauBranchandCutAlgorithmDialaRide2006,
  title = {A {{Branch-and-Cut Algorithm}} for the {{Dial-a-Ride Problem}}},
  author = {Cordeau, Jean-Fran{\c c}ois},
  year = 2006,
  journal = {Operations Research},
  volume = {54},
  number = {3},
  eprint = {25146992},
  eprinttype = {jstor},
  pages = {573--586},
  publisher = {INFORMS},
  issn = {0030-364X},
  urldate = {2026-05-27},
  abstract = {In the dial-a-ride problem, users formulate requests for transportation from a specific origin to a specific destination. Transportation is carried out by vehicles providing a shared service. The problem consists of designing a set of minimum-cost vehicle routes satisfying capacity, duration, time window, pairing, precedence, and ride-time constraints. This paper introduces a mixed-integer programming formulation of the problem and a branch-and-cut algorithm. The algorithm uses new valid inequalities for the dial-a-ride problem as well as known valid inequalities for the traveling salesman, the vehicle routing, and the pick-up and delivery problems. Computational experiments performed on randomly generated instances show that the proposed approach can be used to solve small to medium-size instances.},
  file = {C:\Users\sjaak\Zotero\storage\LSA5N624\Cordeau - 2006 - A Branch-and-Cut Algorithm for the Dial-a-Ride Problem.pdf}
}

@article{dianaNewRegretInsertion2004,
  title = {A New Regret Insertion Heuristic for Solving Large-Scale Dial-a-Ride Problems with Time Windows},
  author = {Diana, Marco and Dessouky, Maged M.},
  year = 2004,
  month = jul,
  journal = {Transportation Research Part B: Methodological},
  volume = {38},
  number = {6},
  pages = {539--557},
  issn = {0191-2615},
  doi = {10.1016/j.trb.2003.07.001},
  urldate = {2026-04-30},
  abstract = {In this paper we present a parallel regret insertion heuristic to solve a dial-a-ride problem with time windows. A new route initialization procedure is implemented, that keeps into account both the spatial and the temporal aspects of the problem, and a regret insertion is then performed to serve the remaining requests. The considered operating scenario is representative of a large-scale dial-a-ride program in Los Angeles County. The proposed algorithm was tested on data sets of 500 and 1000 requests built from data of paratransit service in this area. The computational results show the effectiveness of this approach in terms of trading-off solution quality and computational times. The latter measure being especially important in large-scale systems where numerous daily requests need to be processed.},
  keywords = {Dial-a-ride problem,Heuristics,Paratransit services,Public transportation},
  file = {C\:\\Users\\sjaak\\Zotero\\storage\\44EYRKKQ\\Diana and Dessouky - 2004 - A new regret insertion heuristic for solving large-scale dial-a-ride problems with time windows.pdf;C\:\\Users\\sjaak\\Zotero\\storage\\9BWV9RAS\\S0191261503000912.html}
}

@article{dumasPickupDeliveryProblem1991,
  title = {The Pickup and Delivery Problem with Time Windows},
  author = {Dumas, Yvan and Desrosiers, Jacques and Soumis, Fran{\c c}ois},
