@inproceedings{shawUsingConstraintProgramming1998,
  title = {Using {{Constraint Programming}} and {{Local Search Methods}} to {{Solve Vehicle Routing Problems}}},
  booktitle = {Principles and {{Practice}} of {{Constraint Programming}} --- {{CP98}}},
  author = {Shaw, Paul},
  editor = {Maher, Michael and Puget, Jean-Francois},
  year = 1998,
  pages = {417--431},
  publisher = {Springer},
  address = {Berlin, Heidelberg},
  abstract = {We use a local search method we term Large Neighbourhood Search (LNS) to solve vehicle routing problems. LNS is analogous to the shuffing technique of job-shop scheduling, and so meshes well with constraint programming technology. LNS explores a large neighbourhood of the current solution by selecting a number of ``related'' customer visits to remove from the set of planned routes, and re-inserting these visits using a constraint-based tree search. Unlike similar methods, we use Limited Discrepancy Search during the tree search to re-insert visits. We analyse the performance of our method on benchmark problems. We demonstrate that results produced are competitive with Operations Research meta-heuristic methods, indicating that constraint-based technology is directly applicable to vehicle routing problems},
  isbn = {978-3-540-49481-2},
  langid = {english},
  keywords = {Benchmark Problem,Constraint Programming,Insertion Point,Local Search,Time Window},
  file = {C:\Users\sjaak\Zotero\storage\XCQG8EQ6\Shaw - 1998 - Using Constraint Programming and Local Search Methods to Solve Vehicle Routing Problems.pdf}
}
